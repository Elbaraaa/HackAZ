# Neon Postgres connection string for real users, approvals, and sessions
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Backboard server-side settings
BACKBOARD_API_KEY=your_backboard_api_key
BACKBOARD_ASSISTANT_ID=your_backboard_assistant_id
BACKBOARD_MODEL_PROVIDER=openai
BACKBOARD_MODEL_NAME=gpt-4o-mini

# Google Gemini/Gemma API key for summaries and image analysis
GEMINI_API_KEY=your_gemini_api_key

# Mapbox public browser token for the outbreak map
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_access_token
