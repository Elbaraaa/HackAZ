# Auth0 client-side SPA settings
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_auth0_spa_client_id
VITE_AUTH0_AUDIENCE=https://api.sentinel-health.local
VITE_AUTH0_REDIRECT_URI=http://localhost:8080
VITE_AUTH0_USE_REFRESH_TOKENS=true

# Auth0 server-side API token verification
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com/
AUTH0_AUDIENCE=https://api.sentinel-health.local

# Backboard server-side settings
BACKBOARD_API_KEY=your_backboard_api_key
BACKBOARD_ASSISTANT_ID=your_backboard_assistant_id
BACKBOARD_MODEL_PROVIDER=openai
BACKBOARD_MODEL_NAME=gpt-4o-mini

# Mapbox public browser token for the outbreak map
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_access_token
